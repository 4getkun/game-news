---
// Adventure logを X などで共有するときの URL(/game-news/share/lv12/)。
// X は共有された URL のページの og:image を投稿に埋め込むので、Levelごとのカード
// (public/share/lv12.png。tools/make-share-cards.py で作る)を示す。
// 人が開いたときはトップへすぐ移る。検索には載せない。
import { withBase } from "../../lib/url";

export function getStaticPaths() {
  return Array.from({ length: 99 }, (_, i) => ({ params: { lv: `lv${i + 1}` }, props: { level: i + 1 } }));
}

const { level } = Astro.props as { level: number };
// src/scripts/bouken.ts の titleOf と同じ
const title =
  level >= 50 ? "Legendary gamer"
  : level >= 35 ? "Gaming sage"
  : level >= 25 ? "Gaming expert"
  : level >= 15 ? "Veteran gamer"
  : level >= 8 ? "Seasoned gamer"
  : level >= 4 ? "Rookie gamer"
  : "Apprentice gamer";
const top = new URL(withBase("/"), Astro.site).toString();
const image = new URL(withBase(`/share/lv${level}.png`), Astro.site).toString();
const url = new URL(withBase(`/share/lv${level}/`), Astro.site).toString();
const pageTitle = `Adventure log Level ${level}「${title}」｜All Game News`;
const description = "Read gaming news daily and level up. Your All Game News adventure log.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={top} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="All Game News" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <script is:inline define:vars={{ top }}>location.replace(top);</script>
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; gap: 16px; background: #070b24; color: #fff; font-family: system-ui, sans-serif; }
      img { max-width: min(600px, 92vw); height: auto; }
      a { color: #ffd84a; }
    </style>
  </head>
  <body>
    <main>
      <img src={withBase(`/share/lv${level}.png`)} width="1200" height="630" alt={`Japanese-language adventure card. Level ${level}「${title}」`} />
      <p>Original share-card artwork is in Japanese.</p>
      <p><a href={top}>All Game News : open</a></p>
    </main>
  </body>
</html>

