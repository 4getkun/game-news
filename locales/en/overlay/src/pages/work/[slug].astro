---
// Title page。記事が2 articles以上あるゲームTitlesごとに1ページ(src/lib/news.ts の workPages)。
// そのTitlesの記事をNewest firstに並べ、Schedule(カレンダー)に載っている日付があれば上に出す。
import Base from "../../layouts/Base.astro";
import NewsItem from "../../components/NewsItem.astro";
import { workPages, calendar, categories, formatDateTime } from "../../lib/news";
import type { WorkPage } from "../../lib/news";
import { withBase } from "../../lib/url";
import { breadcrumb, absUrl } from "../../lib/seo";

export function getStaticPaths() {
  return workPages.map((w) => ({ params: { slug: w.slug }, props: { work: w } }));
}

const { work } = Astro.props as { work: WorkPage };
const items = work.items;
const schedule = calendar.filter((e) => e.work === work.name);
const first = items[items.length - 1]?.pubDate;
const last = items[0]?.pubDate;
// 記事に多く付いているCategories上位3つ(ページの説明文に使う)
const catCount = new Map<string, number>();
for (const it of items) for (const c of it.categories) catCount.set(c, (catCount.get(c) ?? 0) + 1);
const catLabel = Object.fromEntries(categories.map((c) => [c.id, c.label]));
const topCats = [...catCount.entries()].sort((a, b) => b[1] - a[1]).slice(0, 3).map(([c]) => catLabel[c]);
const description = `${items.length} news articles about ${work.name}. ${topCats.length ? `${topCats.join(", ")}.` : ""}`;
// パンくず + このTitles news一覧(CollectionPage)。記事そのものは各Sourcesのものなのでリンク先の URL だけ並べる
const jsonLd = [
  breadcrumb([
    { name: "Title index", path: "/work/" },
    { name: work.name, path: `/work/${work.slug}/` },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${work.name} news`,
    url: absUrl(`/work/${work.slug}/`),
    inLanguage: "ja",
    description,
    about: { "@type": "VideoGame", name: work.name },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: items.length,
      itemListElement: items.slice(0, 20).map((it, i) => ({ "@type": "ListItem", position: i + 1, url: it.link, name: it.title })),
    },
  },
];
const dateLabel = (d: string, precision: string) => {
  const [y, m, day] = d.split("-");
  return precision === "month" ? `${y}-${m}` : `${y}-${m}-${day}`;
};
---

<Base title={`${work.name} news`} description={description} jsonLd={jsonLd}>
  <section class="wrap work-page">
    <p class="crumbs"><a href={withBase("/work/")}>Title index</a></p>
    <h1 class="work-title">{work.name}</h1>
    <p class="work-meta">
      News {items.length} articles
      {first && last && <>({formatDateTime(first)} – {formatDateTime(last)})</>}
    </p>
    <p class="work-actions">
      <a class="btn btn-solid" href={`${withBase("/")}?work=${encodeURIComponent(work.name)}#feed`}>Open filters and follow</a>
    </p>

    {schedule.length > 0 && (
      <section class="work-schedule win">
        <span class="win-title">Schedule</span>
        <ul>
          {schedule.map((e) => (
            <li>
              <strong>{dateLabel(e.date, e.precision)}</strong> {e.label}
              <a href={e.link} target="_blank" rel="noopener noreferrer">{e.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="day">
      <div class="day-head"><h2>News</h2><span>Newest first</span></div>
      {items.map((it) => <NewsItem item={it} showDate />)}
    </div>
  </section>
</Base>

