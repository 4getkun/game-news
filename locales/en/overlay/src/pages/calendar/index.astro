---
// Schedule(カレンダー)。見出しから拾った「日付＋動詞」を月ごと・日ごとに並べる(scripts/fetch-news.mjs の buildCalendar)。
// 月までしか分からないSchedule(「2027年1月放送」)は、その月の先頭に「◯月中」としてまとめる。
import Base from "../../layouts/Base.astro";
import { calendar, workSlugByName, generatedAt, formatDateTime, platforms, scheduleLabels } from "../../lib/news";
import filters from "../../data/filters.json";
import { withBase } from "../../lib/url";
import { breadcrumb } from "../../lib/seo";

const verbs = (filters as unknown as { schedule: { verbs: { id: string; label: string }[] } }).schedule.verbs.map(v => ({...v, label: scheduleLabels[v.id] ?? v.label}));
const weekday = new Intl.DateTimeFormat("en-GB", { weekday: "short", timeZone: "UTC" });
const todayKey = new Intl.DateTimeFormat("sv-SE", { timeZone: "Asia/Tokyo" }).format(new Date(generatedAt));

// 過ぎた日のScheduleは出さない(月までしか分からないScheduleは、その月が終わるまで出す)
const upcoming = calendar.filter((e) => (e.precision === "month" ? e.date.slice(0, 7) >= todayKey.slice(0, 7) : e.date >= todayKey));

type Entry = (typeof calendar)[number];
const months = new Map<string, { monthOnly: Entry[]; days: Map<string, Entry[]> }>();
for (const e of upcoming) {
  const ym = e.date.slice(0, 7);
  if (!months.has(ym)) months.set(ym, { monthOnly: [], days: new Map() });
  const m = months.get(ym)!;
  if (e.precision === "month") m.monthOnly.push(e);
  else {
    if (!m.days.has(e.date)) m.days.set(e.date, []);
    m.days.get(e.date)!.push(e);
  }
}
const platLabel = Object.fromEntries(platforms.map((p) => [p.id, p.label]));
const monthLabel = (ym: string) => ym;
const dayLabel = (d: string) => {
  const [y, m, day] = d.split("-").map(Number);
  return `${y}-${String(m).padStart(2, "0")}-${String(day).padStart(2, "0")} (${weekday.format(new Date(Date.UTC(y, m - 1, day)))})`;
};
---

<Base
  jsonLd={breadcrumb([{ name: "Schedule", path: "/calendar/" }])}
  title="Schedule (releases and updates)"
  description="A date-ordered calendar of releases, updates, demos and events extracted from Japanese gaming headlines."
>
  <section class="wrap cal-page">
    <h1 class="work-title">Schedule</h1>
    <p class="work-meta">
      Dates are extracted from Japanese headlines ({upcoming.length} events as of {formatDateTime(generatedAt)}, Japan time).
      Check the original articles for confirmed dates.
    </p>
    <div class="chips cal-filter" id="cal-filter" role="group" aria-label="Filter by type">
      <button type="button" class="chip" data-verb="all" aria-pressed="true">All</button>
      {verbs.map((v) => <button type="button" class="chip" data-verb={v.id} aria-pressed="false">{v.label}</button>)}
    </div>

    {upcoming.length === 0 && <p class="empty">No upcoming events right now.</p>}

    {[...months.entries()].map(([ym, m]) => (
      <section class="cal-month">
        <h2 class="cal-month-head">{monthLabel(ym)}</h2>
        {m.monthOnly.length > 0 && (
          <div class="cal-day">
            <h3 class="cal-day-head">During {ym}</h3>
            <ul class="cal-list">
              {m.monthOnly.map((e) => (
                <li data-verb={e.verb}>
                  <span class={`cal-verb cal-verb-${e.verb}`}>{e.label}</span>
                  {e.work && workSlugByName[e.work] ? (
                    <a class="cal-work" href={withBase(`/work/${workSlugByName[e.work]}/`)}>{e.work}</a>
                  ) : e.work ? <span class="cal-work">{e.work}</span> : null}
                  {e.platforms.map((p) => <span class="plat">{platLabel[p]}</span>)}
                  <a class="cal-title" href={e.link} target="_blank" rel="noopener noreferrer">{e.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {[...m.days.entries()].map(([d, list]) => (
          <div class={`cal-day${d === todayKey ? " is-today" : ""}`} data-date={d}>
            <h3 class="cal-day-head">{dayLabel(d)}{d === todayKey && <span class="cal-today">Today</span>}</h3>
            <ul class="cal-list">
              {list.map((e) => (
                <li data-verb={e.verb}>
                  <span class={`cal-verb cal-verb-${e.verb}`}>{e.label}</span>
                  {e.work && workSlugByName[e.work] ? (
                    <a class="cal-work" href={withBase(`/work/${workSlugByName[e.work]}/`)}>{e.work}</a>
                  ) : e.work ? <span class="cal-work">{e.work}</span> : null}
                  {e.platforms.map((p) => <span class="plat">{platLabel[p]}</span>)}
                  <a class="cal-title" href={e.link} target="_blank" rel="noopener noreferrer">{e.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))}
  </section>
</Base>

<script is:inline>
  // ページは1時間ごとに作り直すので、日付が変わった直後は前日のScheduleが残ることがある。開いた時点で過ぎた日は消す
  const today = new Intl.DateTimeFormat("sv-SE", { timeZone: "Asia/Tokyo" }).format(new Date());
  document.querySelectorAll(".cal-day[data-date]").forEach((d) => d.dataset.date < today && d.remove());
  document.querySelectorAll(".cal-month").forEach((m) => !m.querySelector(".cal-day") && m.remove());
  // Filter by type(空になった日・月は隠す)
  const buttons = document.querySelectorAll("#cal-filter [data-verb]");
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      const v = b.dataset.verb;
      buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      document.querySelectorAll(".cal-list li").forEach((li) => (li.hidden = v !== "all" && li.dataset.verb !== v));
      document.querySelectorAll(".cal-day").forEach((d) => (d.hidden = !d.querySelector("li:not([hidden])")));
      document.querySelectorAll(".cal-month").forEach((m) => (m.hidden = !m.querySelector(".cal-day:not([hidden])")));
    }),
  );
</script>

