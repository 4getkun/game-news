{
  "name": "All Game News",
  "short_name": "Game News",
  "description": "Gaming RSS reader with platform and topic filters. Japanese articles remain in Japanese.",
  "lang": "en",
  "start_url": "/game-news/en/",
  "scope": "/game-news/en/",
  "display": "standalone",
  "background_color": "#13206E",
  "theme_color": "#13206E",
  "icons": [
    {
      "src": "/game-news/en/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/game-news/en/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/game-news/en/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
