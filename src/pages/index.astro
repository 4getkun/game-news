---
import Base from "../layouts/Base.astro";
import NewsItem from "../components/NewsItem.astro";
import {
  jaNews,
  generatedAt,
  feeds,
  categories,
  topicCategories,
  sensitiveCategories,
  platforms,
  platformCounts,
  recentCount,
  kindLabels,
  trendingWorks,
  workSlugByName,
  dealStores,
  currentDeals,
} from "../lib/news";
import { withBase } from "../lib/url";

// ヒーローはビルド時に描くので、閲覧側の「見たくない話題を隠す」が効かない。
// 事件・トラブルの話題は最初から載せない(一覧では設定どおりに表示・非表示)
const sensitiveIds = new Set(sensitiveCategories.map((c) => c.id));
const showcase = jaNews.filter((it) => !it.categories.some((c) => sensitiveIds.has(c)));
const latest = showcase[0];
const works = trendingWorks(72, 12);
const recent = recentCount(24);
const platStats = platformCounts(24);
const platMax = Math.max(1, ...platStats.map((p) => p.count));
// JavaScript が動かない環境でも最新分だけは読めるように、先頭だけサーバー側で描く
const initialItems = jaNews.slice(0, 30);
// ツールバーの「セール」ボタンに出す、この1週間のセール・無料配布の件数(読み込み後はブラウザ側で数え直す)
const deals = currentDeals(7);

const config = {
  dataUrl: withBase("/data/news.json"),
  generatedAt,
  categories: categories.map(({ id, label, emoji, sensitive }) => ({ id, label, emoji, sensitive: !!sensitive })),
  platforms,
  stores: dealStores,
  feeds: feeds.map(({ id, name, kind, lang }) => ({ id, name, kind, lang })),
  kindLabels,
  workSlugs: workSlugByName,
  baseUrl: withBase("/"),
};


// メッセージウィンドウの1文字ずつ表示。文字ごとに span を作り、表示の遅れを --i で渡す
const chars = (text: string) => Array.from(text);
const line1 = `ゲームのニュースが ${recent}けん とどいた！`;
const line2 = latest ? `▶ ${latest.title}` : "";
const line2Delay = chars(line1).length * 28 + 350;
// ▼(またはウィンドウ)を押すと次のニュースへ送る。送る順番の見出し(見たくない話題は除く)
const heroQueue = showcase.slice(0, 12).map((it) => ({ t: it.title, l: it.link }));
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <h1 id="hero-title" class="hero-title"><a class="hero-home" href={withBase("/")}>ゲームのニュースを<br />ぜんぶ よむ。</a></h1>
      <p class="hero-lede">
        {feeds.length}媒体のRSSを1時間ごとに集めて、転載や同じ話題はひとつにまとめています。<br />
        機種・話題で絞り込み、推しタイトルはフォロー、ネタバレはぼかして表示します。
      </p>
      <div class="hero-grid">
        <div class="win msg">
          <span class="win-title">おしらせ</span>
          <p class="msg-line">
            <span class="sr-only">{line1}</span>
            <span class="typer" aria-hidden="true">{chars(line1).map((c, i) => <span style={`--i:${i}`}>{c}</span>)}</span>
          </p>
          <button type="button" class="msg-sound" id="msg-sound" aria-pressed="true" aria-label="効果音">♪</button>
          {latest && (
            <p class="msg-line" id="msg-headline">
              <a href={latest.link} target="_blank" rel="noopener noreferrer" id="msg-link">
                <span class="sr-only" id="msg-sr">いちばん新しいニュース: {latest.title}</span>
                <span class="typer" id="msg-typed" aria-hidden="true" style={`--d:${line2Delay}ms`}>
                  {chars(line2).map((c, i) => <span style={`--i:${i}`}>{c}</span>)}
                </span>
              </a>
            </p>
          )}
          <div class="msg-foot">
            <span class="msg-count" id="msg-count" aria-live="polite">1/{heroQueue.length}</span>
            <button type="button" class="msg-next" id="msg-next" aria-label="次のニュースを表示">▼</button>
          </div>
          <script type="application/json" id="hero-queue" set:html={JSON.stringify(heroQueue)} />
        </div>
        <nav class="win status" aria-label="この24時間の機種別の件数">
          <span class="win-title">ステータス（24時間）</span>
          {platStats.map((p) => (
            <a class="status-row" href={`${withBase("/")}?plat=${p.id}#feed`} data-plat-link={p.id}>
              <span>{p.label}</span>
              <span class="status-bar" aria-hidden="true"><i style={`--w:${Math.round((p.count / platMax) * 100)}%`}></i></span>
              <span class="status-num">{p.count}</span>
            </a>
          ))}
          <p class="status-foot">媒体 {feeds.length} ／ 日本語の記事 ぜんぶで {jaNews.length}件</p>
        </nav>
      </div>
      {works.length > 0 && (
        <nav class="win works-win" aria-label="この3日間で話題のタイトル">
          <span class="win-title">わだいの タイトル</span>
          <ul class="works-list">
            {works.map((w) => (
              <li>
                <a class="cursor-row" href={`${withBase("/")}?work=${encodeURIComponent(w.name)}#feed`} data-work-link={w.name}>{w.name}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </section>

  <div class="toolbar" id="feed">
    <div class="wrap">
      <label class="search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span class="sr-only">キーワードで絞り込む</span>
        <input id="q" type="search" placeholder="タイトル名・会社名で絞り込む（-語 で除外）" autocomplete="off" enterkeyhint="search" />
      </label>
      <div class="segmented" role="group" aria-label="期間" id="period">
        <button type="button" data-value="all" aria-pressed="true">すべて</button>
        <button type="button" data-value="24h" aria-pressed="false">24時間</button>
        <button type="button" data-value="3d" aria-pressed="false">3日</button>
        <button type="button" data-value="7d" aria-pressed="false">7日</button>
      </div>
      <div class="segmented" role="group" aria-label="並び順" id="sort">
        <button type="button" data-value="new" aria-pressed="true">新着順</button>
        <button type="button" data-value="hot" aria-pressed="false">話題順</button>
      </div>
      <button type="button" class="btn deal-toggle" id="deal-toggle" data-deal-toggle="" aria-pressed="false">
        <span aria-hidden="true">🏷️</span> セール <span class="deal-count">{deals.length}</span>
      </button>
      <button type="button" class="btn new-only" id="new-only" aria-pressed="false" hidden>
        前回から新着 <span class="new-count">0</span>件
      </button>
      <button type="button" class="btn filter-open" id="filter-open" aria-controls="panel" aria-expanded="false">
        コマンド<span id="filter-badge"></span>
      </button>
    </div>
  </div>

  <div class="wrap layout">
    <aside class="panel win" id="panel" aria-label="絞り込み">
      <div class="panel-head">
        <h2>コマンド</h2>
        <button type="button" class="icon-btn" id="filter-close" aria-label="絞り込みを閉じる">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>

      <section class="panel-shop">
        <h2>ショップ（セール） <button type="button" data-clear="deal">解除</button></h2>
        <div class="menu" id="store-menu">
          {dealStores.map((st) => (
            <button type="button" class="menu-item cursor-row" data-store={st.id} aria-pressed="false">
              <span>{st.label}</span><span class="count"></span>
            </button>
          ))}
        </div>
        <p class="hint">セール・無料配布の記事を店で絞り込みます。見出しで判定（マンガのポイント還元や本体の値引きは除く）。</p>
      </section>

      <section>
        <h2>きしゅ <button type="button" data-clear="plats">すべて解除</button></h2>
        <div class="menu" id="plat-menu">
          {platforms.map((p) => (
            <button type="button" class="menu-item cursor-row" data-plat={p.id} aria-pressed="false">
              <span>{p.label}</span><span class="count"></span>
            </button>
          ))}
        </div>
        <p class="hint">複数選ぶと、どれかの機種に当てはまる記事を表示します。</p>
      </section>

      <section>
        <h2>わだい <button type="button" data-clear="cats">すべて解除</button></h2>
        <div class="menu" id="cat-chips">
          {topicCategories.map((c) => (
            <button type="button" class="menu-item cursor-row" data-cat={c.id} aria-pressed="false">
              <span>{c.label}</span><span class="count"></span>
            </button>
          ))}
        </div>
      </section>

      <section>
        <h2>フォロー中のタイトル</h2>
        <div class="chips" id="follow-list"></div>
        <label class="toggle">
          <span>フォロー中のタイトルだけ表示</span>
          <input type="checkbox" id="only-follow" />
        </label>
        <p class="hint">記事のタイトル名（◆）を押して「フォロー」すると、ここに並びます。</p>
      </section>

      <section>
        <h2>見たくない話題を隠す</h2>
        {sensitiveCategories.map((c) => (
          <label class="toggle">
            <span>{c.label}<small>{c.hint}</small></span>
            <input type="checkbox" data-hide-topic={c.id} />
          </label>
        ))}
        <p class="hint">見出しで判定します。タイトル名の中の語では隠れません。</p>
      </section>

      <section>
        <h2>ひょうじ</h2>
        <label class="toggle">
          <span>ネタバレをぼかす<small>エンディング・ラスボスなどの見出し</small></span>
          <input type="checkbox" id="spoiler-blur" checked />
        </label>
        <label class="toggle">
          <span>読んだ記事を隠す</span>
          <input type="checkbox" id="hide-read" />
        </label>
        <label class="toggle">
          <span>複数の媒体が報じた話題だけ</span>
          <input type="checkbox" id="multi-only" />
        </label>
      </section>

      <section class="fold-section">
        <details class="fold" data-fold="mute">
          <summary class="fold-head"><h2>ミュートする言葉</h2><span class="fold-note" id="mute-note"></span></summary>
          <form class="word-form" id="mute-form">
            <input id="mute-input" type="text" placeholder="例: ガチャ" aria-label="ミュートする言葉" />
            <button type="submit">ついか</button>
          </form>
          <div class="chips word-list" id="mute-list"></div>
          <p class="hint">見出し・要約・タイトル名にこの語を含む記事を隠します。設定はこの端末にだけ保存されます。</p>
        </details>
      </section>

      <section class="fold-section">
        <details class="fold" data-fold="lang">
          <summary class="fold-head"><h2>ことば</h2><span class="fold-note" id="lang-note"></span></summary>
          <div class="segmented" role="group" aria-label="言語" id="lang">
            <button type="button" data-value="ja" aria-pressed="true">日本語</button>
            <button type="button" data-value="all" aria-pressed="false">すべて</button>
            <button type="button" data-value="en" aria-pressed="false">English</button>
          </div>
        </details>
      </section>

      <section class="fold-section">
        <details class="fold" data-fold="sources">
          <summary class="fold-head"><h2>ばいたい</h2><span class="fold-note" id="sources-note"></span></summary>
          <p class="fold-actions"><button type="button" data-clear="sources">すべて表示</button></p>
          <ul class="source-list" id="source-list">
            {feeds.map((f) => (
              <li>
                <label>
                  <input type="checkbox" data-source={f.id} checked />
                  <span class={`kind-mark kind-${f.kind}`} title={kindLabels[f.kind]}></span>
                  {f.name}
                  <span class="count"></span>
                </label>
              </li>
            ))}
          </ul>
          <p class="hint">
            色は媒体の種類です。
            {Object.entries(kindLabels).map(([k, label]) => (
              <span style="white-space:nowrap; margin-right:8px;"><span class={`kind-mark kind-${k}`} style="margin-right:4px;"></span>{label}</span>
            ))}
          </p>
        </details>
      </section>
    </aside>

    <div class="feed-col">
      <div class="active-filters" id="active-filters"></div>
      <div id="work-banner"></div>
      <div id="feed-list">
        <div class="day">
          <div class="day-head">
            <h2>最新</h2>
            <!-- 件数は一覧の最初の日付の見出しの右端に置く(一覧を描き直すたびに feed.ts が付け直す) -->
            <p class="feed-count" aria-live="polite"><span id="hidden-note"></span><span><strong id="result-count">{jaNews.length}</strong> 件</span></p>
          </div>
          {initialItems.map((it) => <NewsItem item={it} showThumb={false} />)}
        </div>
      </div>
      <div class="feed-more"><button type="button" class="btn" id="more" hidden>つづきを表示</button></div>
    </div>
  </div>
  <div class="scrim" id="scrim" hidden></div>

  <script type="application/json" id="app-config" set:html={JSON.stringify(config)} />
</Base>

<script>
  import { startMessageWindow } from "../scripts/message-window";
  startMessageWindow();
</script>

<script>
  import { startFeed } from "../scripts/feed";
  // 絞り込み用のデータ(数百KB)の読み込みと一覧の描き直しは、最初の表示が終わってから行う。
  // それまではサーバー側で描いた最新30件が見えている
  const run = () => void startFeed();
  if ("requestIdleCallback" in window) requestIdleCallback(run, { timeout: 1500 });
  else setTimeout(run, 200);
</script>
