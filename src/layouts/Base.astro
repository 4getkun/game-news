---
import "../styles/global.css";
import { withBase } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** 構造化データ(JSON-LD)。ページごとのパンくずなど。サイト全体の WebSite はトップだけに付ける */
  jsonLd?: unknown;
}

const SITE_NAME = "ゲームニュース全部";
const {
  title,
  description = "4Gamer・AUTOMATON・ファミ通・電撃・Googleニュースなど20以上のRSSを1時間ごとに集めて、機種や話題で見たいニュースだけに絞り込めるゲームニュースまとめ。",
  noindex = false,
  jsonLd,
} = Astro.props;
// 見出し・メニュー用のドット書体 DotGothic16 は、よく使う文字だけに絞ったものを自前で配る(tools/make-font-subset.py)。
// Google Fonts だと約120個に分かれたファイルが届くたびに配置をやり直し、最初の表示が遅くなっていた
const FONT_URL = withBase("/fonts/dotgothic16-sub.woff2");
const isHome = Astro.url.pathname === import.meta.env.BASE_URL;
const siteUrl = new URL(withBase("/"), Astro.site).toString();
const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_NAME,
  url: siteUrl,
  inLanguage: "ja",
  description,
  isPartOf: { "@type": "WebSite", name: "fourgetkun 工房", url: "https://fourgetkun.com/" },
};
const pageTitle = title ? `${title}｜${SITE_NAME}` : `${SITE_NAME}｜ゲームニュースRSSまとめ`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(withBase("/og-image.png"), Astro.site).toString();
// 公開トップの絶対URL。配信元(pages.dev)を直接開かれたときの転送先
const publicBaseUrl = new URL(withBase("/"), Astro.site).toString();
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
const nav = [
  { href: withBase("/"), label: "ニュース", current: path === "/" },
  { href: withBase("/calendar/"), label: "よてい", current: path.startsWith("/calendar") },
  { href: withBase("/work/"), label: "タイトル", current: path.startsWith("/work") },
  { href: withBase("/about/"), label: "しくみ", current: path.startsWith("/about"), wide: true },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <script is:inline define:vars={{ publicBaseUrl }}>
      // 配信元の Cloudflare Pages(game-news.pages.dev やプレビュー用の *.game-news.pages.dev)を
      // 直接開かれたら、同じページの公開URL(fourgetkun.com/game-news/...)へ送る。
      // HTML は公開側の base 前提でリンクを組んでいるので、pages.dev 上では CSS 等が読めない。
      if (/(^|\.)game-news\.pages\.dev$/.test(location.hostname)) {
        location.replace(publicBaseUrl + location.pathname.replace(/^\/(game-news\/?)?/, "") + location.search + location.hash);
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- アイコン一式は tools/make-icons.py で作る(ドット絵なので 16px でもそのまま読める) -->
    <link rel="icon" href={withBase("/favicon.ico")} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <link rel="manifest" href={withBase("/manifest.webmanifest")} />
    <link rel="alternate" type="application/rss+xml" title="ゲームニュース全部（全記事）" href={withBase("/feed.xml")} />
    <meta name="theme-color" content="#13206e" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" as="font" type="font/woff2" href={FONT_URL} crossorigin />
    <style set:html={`@font-face{font-family:"DotGothic16 Sub";src:url("${FONT_URL}") format("woff2");font-display:swap}`} />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />}
    {jsonLd !== undefined && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // テーマの初期化(ちらつき防止のため head 内で実行)。保存が無ければOS設定に従う
      try {
        const t = localStorage.getItem("game-news:theme");
        if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only">本文へ移動</a>
    <header class="site-header">
      <div class="wrap">
        <a href={withBase("/")} class="logo" aria-label={SITE_NAME}>
          <img class="logo-mark" src={withBase("/favicon.svg")} alt="" width="30" height="30" />
          <span>ゲームニュース<span class="logo-text-long">全部</span></span>
        </a>
        <nav class="site-nav" aria-label="サイト内">
          {nav.map((n) => (
            <a class={`cursor-row${n.wide ? " nav-wide" : ""}`} href={n.href} aria-current={n.current ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
        <button id="theme-toggle" class="icon-btn" type="button" aria-label="ライト/ダーク表示を切り替える">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"/></svg>
        </button>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>見出し・要約・リンクのみ掲載しています。記事の全文は各配信元でお読みください。</p>
        <p>
          <a href={withBase("/about/")}>収集元とフィルタのしくみ</a>
          ・ 姉妹サイト <a href="https://fourgetkun.com/anime-news/">アニメニュース全部</a>
        </p>
      </div>
    </footer>
    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const isDark =
          root.dataset.theme === "dark" ||
          (!root.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
        root.dataset.theme = isDark ? "light" : "dark";
        try { localStorage.setItem("game-news:theme", root.dataset.theme); } catch {}
      });
    </script>
  </body>
</html>
